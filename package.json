{
  "name": "hollywood-animal-planner",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run wasm:build && vue-tsc -b && vite build",
    "preview": "vite preview",
    "asbuild:debug": "asc assembly/index.ts --target debug",
    "asbuild:release": "asc assembly/index.ts --target release",
    "asbuild": "npm run asbuild:debug && npm run asbuild:release",
    "wasm:build": "npm run asbuild:release && cp build/release.wasm public/wasm/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:legacy": "node tests",
    "start": "npx serve ."
  },
  "dependencies": {
    "@headlessui/vue": "^1.7.23",
    "@heroicons/vue": "^2.2.0",
    "pinia": "^2.1.7",
    "pinia-plugin-persistedstate": "^3.2.1",
    "vue": "^3.4.21",
    "vue-i18n": "^9.14.5",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@rollup/plugin-wasm": "^6.2.2",
    "@types/node": "^20.19.33",
    "@vitejs/plugin-vue": "^5.0.4",
    "assemblyscript": "^0.28.9",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "typescript": "~5.4.0",
    "vite": "^5.2.0",
    "vitest": "^4.0.18",
    "vue-tsc": "^2.0.0"
  },
  "exports": {
    ".": {
      "import": "./build/release.js",
      "types": "./build/release.d.ts"
    }
  }
}
